<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/screen_problem_resolution_0"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_problem_resolution"
        android:background="@color/background_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/problem_resolution_button">
        <LinearLayout
            android:gravity="top"
            android:orientation="vertical"
            android:background="@color/background_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_default">
                <TextView
                    android:textSize="@dimen/text_size_medium"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/diagnostic_test"
                    android:fontFamily="@font/font_regular"/>
                <TextView
                    android:textSize="16dp"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/edit_text_max_width"
                    android:text="@string/diagnostic_text_description"
                    android:minLines="3"
                    android:fontFamily="@font/font_light"/>
                <TextView
                    android:textSize="18dp"
                    android:textColor="@color/primary_red"
                    android:gravity="center_horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxWidth="@dimen/edit_text_max_width"
                    android:text="@string/diagnostic_text_red_text"
                    android:fontFamily="@font/font_bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@color/out_of_the_box_light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/div_height"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_default">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/container_text_bt_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="@dimen/text_size_small"
                            android:id="@+id/text_view_title_bt_diagnostic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/edit_text_max_width"
                            android:text="@string/diagnostic_verify_bt_conn_title"
                            android:fontFamily="@font/font_regular"/>
                        <TextView
                            android:textSize="@dimen/text_size_small_alert"
                            android:id="@+id/text_view_subtitle_bt_diagnostic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/diagnostic_verify_bt_conn_subtitle"
                            android:fontFamily="@font/font_light"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/img_bt_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_bt_diagnostic"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/app_name"
                        android:layout_alignEnd="@+id/container_text_bt_diagnostic"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:background="@color/out_of_the_box_light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/div_height"/>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/container_view_care_diagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_default">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/container_text_care_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="@dimen/text_size_small"
                            android:id="@+id/text_view_title_care_diagnostic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/edit_text_max_width"
                            android:text="@string/diagnostic_verify_care_conn_title"
                            android:fontFamily="@font/font_regular"/>
                        <TextView
                            android:textSize="@dimen/text_size_small_alert"
                            android:id="@+id/text_view_subtitle_care_diagnostic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/diagnostic_verify_care_conn_subtitle"
                            android:fontFamily="@font/font_light"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/img_care_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_care_diagnostic"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/app_name"
                        android:layout_alignEnd="@+id/container_text_care_diagnostic"
                        android:layout_alignParentEnd="true"/>
                    <ProgressBar
                        android:id="@+id/progress_care_diagnostic"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_care_diagnostic"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_alignEnd="@+id/container_text_care_diagnostic"
                        android:layout_alignParentEnd="true"
                        style="?android:attr/progressBarStyleSmall"/>
                </RelativeLayout>
                <View
                    android:background="@color/out_of_the_box_light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/div_height"/>
                <RelativeLayout
                    android:id="@+id/container_view_turn_off_engine_diagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_default">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/container_text_turn_of_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="@dimen/text_size_small"
                            android:id="@+id/text_view_title_turn_off_diagnostic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/edit_text_max_width"
                            android:text="@string/diagnostic_turn_off_engine"
                            android:fontFamily="@font/font_regular"/>
                        <TextView
                            android:textSize="@dimen/text_size_small_alert"
                            android:id="@+id/text_view_subtitle_turn_off_diagnostic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/diagnostic_verify_turnoff_engine_subtitle"
                            android:fontFamily="@font/font_light"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/img_turn_off_engine_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_turn_of_diagnostic"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/app_name"
                        android:layout_alignEnd="@+id/container_text_turn_of_diagnostic"
                        android:layout_alignParentEnd="true"/>
                    <ProgressBar
                        android:id="@+id/progress_turn_off_engine_diagnostic"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_turn_of_diagnostic"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_alignEnd="@+id/container_text_turn_of_diagnostic"
                        android:layout_alignParentEnd="true"
                        style="?android:attr/progressBarStyleSmall"/>
                </RelativeLayout>
                <View
                    android:background="@color/out_of_the_box_light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/div_height"/>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/container_view_upload_trip_diagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_default">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/container_text_trip_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <TextView
                            android:textSize="@dimen/text_size_small"
                            android:id="@+id/text_view_title_trip_diagnostic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/edit_text_max_width"
                            android:text="@string/diagnostic_verify_trip_start_title"
                            android:fontFamily="@font/font_regular"/>
                        <TextView
                            android:textSize="@dimen/text_size_small_alert"
                            android:id="@+id/text_view_subtitle_trip_diagnostic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/diagnostic_verify_trip_start_subtitle"
                            android:fontFamily="@font/font_light"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/img_trip_diagnostic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_trip_diagnostic"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="@string/app_name"
                        android:layout_alignEnd="@+id/container_text_trip_diagnostic"
                        android:layout_alignParentEnd="true"/>
                    <ProgressBar
                        android:id="@+id/progress_trip_diagnostic"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:minWidth="@dimen/base_icon_diagnostic"
                        android:minHeight="@dimen/base_icon_diagnostic"
                        android:layout_alignRight="@+id/container_text_trip_diagnostic"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_alignEnd="@+id/container_text_trip_diagnostic"
                        android:layout_alignParentEnd="true"
                        style="?android:attr/progressBarStyleSmall"/>
                </RelativeLayout>
                <View
                    android:background="@color/out_of_the_box_light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/div_height"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/container_completed_diagnostic"
        android:background="@color/background_light"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/problem_resolution_button">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="0x7f0800ff"
            android:contentDescription="@string/app_name"/>
        <TextView
            android:textSize="@dimen/text_size_largest"
            android:textColor="@color/accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_default"
            android:text="@string/diagnostic_verify_completed"
            android:fontFamily="@font/font_regular"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/problem_resolution_button"
        android:background="@drawable/background_accent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/out_of_the_box_button_min_height"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/background_light"
            android:gravity="center"
            android:id="@+id/problem_resolution_text_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/diagnostic_text_button"
            android:textAllCaps="false"
            android:fontFamily="@font/font_regular"/>
    </RelativeLayout>
</RelativeLayout>
