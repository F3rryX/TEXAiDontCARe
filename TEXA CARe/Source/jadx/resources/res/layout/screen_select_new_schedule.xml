<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/screen_select_new_schedule_0"
    android:background="@color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_above="@+id/layout_add_confirmed"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small">
                <TextView
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/new_schedule"
                    android:fontFamily="@font/font_regular"
                    style="@style/OotbTitleStyle"/>
                <TextView
                    android:textSize="@dimen/text_size_small_settings"
                    android:textColor="@color/schedule_secondary_text_light"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/margin_small"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginRight="@dimen/margin_small"
                    android:text="@string/new_expiration_text"
                    android:fontFamily="@font/font_light"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_default"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginRight="@dimen/margin_default">
                <TextView
                    android:textSize="@dimen/text_add_schedules_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_type"
                    android:fontFamily="@font/font_light"/>
                <Spinner
                    android:id="@+id/schedule_type_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/edit_text_min_height"
                    android:spinnerMode="dialog"/>
                <View
                    android:background="@color/settings_line_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginBottom="@dimen/margin_small"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/vehicle_data_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/text_add_schedules_label"
                        android:id="@+id/vehicle_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vehicle"
                        android:fontFamily="@font/font_light"/>
                    <Spinner
                        android:id="@+id/vehicle_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/edit_text_min_height"
                        android:spinnerMode="dialog"/>
                    <View
                        android:background="@color/settings_line_color"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginBottom="@dimen/margin_small"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/user_data_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/text_add_schedules_label"
                        android:id="@+id/user_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/user"
                        android:fontFamily="@font/font_light"/>
                    <Spinner
                        android:id="@+id/user_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/edit_text_min_height"
                        android:spinnerMode="dialog"/>
                    <View
                        android:background="@color/settings_line_color"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginBottom="@dimen/margin_small"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_add_confirmed"
        android:background="@drawable/button_green"
        android:padding="@dimen/margin_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_default"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_size_medium"
            android:textColor="@color/primary_text_light"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/label_add_confirmed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/insert_schedule"
            android:maxLines="1"
            android:fontFamily="@font/font_regular"/>
    </LinearLayout>
</RelativeLayout>
