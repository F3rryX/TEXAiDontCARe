<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/settings_list_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/settings_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Settings.Layout">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/settings_item_internal_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:layout_toLeftOf="@+id/settings_item_image"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/settings_item_image">
            <TextView
                android:id="@+id/settings_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Settings.TitleLabelStyle"/>
            <TextView
                android:id="@+id/settings_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_personal_data"
                style="@style/Settings.DescriptionLabelStyle"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/settings_item_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_small"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/settings_list_item_div"
        android:background="@color/settings_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</LinearLayout>
