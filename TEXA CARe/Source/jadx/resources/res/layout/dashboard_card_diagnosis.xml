<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboard_card_diagnosis"
    android:tag="layout/dashboard_card_diagnosis_0"
    android:padding="@dimen/margin_default"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#63686f"
    app:cardCornerRadius="10dp">
    <RelativeLayout
        android:background="@drawable/dashboard_card_background"
        android:padding="@dimen/margin_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/dashboard_card_diagnosis_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/dashboard_card_diagnosis_icon"
                android:layout_width="@dimen/icon_card_dimen"
                android:layout_height="@dimen/icon_card_dimen"
                android:src="@drawable/icon_card_diagnosis"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_default"
                android:layout_toRightOf="@+id/dashboard_card_diagnosis_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_toEndOf="@+id/dashboard_card_diagnosis_icon">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_card_diagnosis_sub_title"
                    style="@style/Dashboard.Card.Module"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dashboard_card_diagnosis_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_card_diagnosis_title"
                    android:maxLines="1"
                    app:autoSizeMinTextSize="10dp"
                    app:autoSizeStepGranularity="1dp"
                    style="@style/Dashboard.Card.Title"/>
                <com.texa.careapp.views.RelativeTimeTextView
                    android:ellipsize="end"
                    android:id="@+id/dashboard_card_diagnosis_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:marqueeRepeatLimit="marquee_forever"
                    app:reference_no_value="@string/dashboard_card_diagnosis_no_time"
                    style="@style/Dashboard.Card.Time"/>
            </LinearLayout>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dashboard_card_diagnosis_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_smaller"
            android:layout_marginBottom="@dimen/margin_smaller"
            android:text="@string/dashboard_card_diagnosis_positive_description"
            android:layout_above="@+id/dashboard_card_diagnosis_button"
            android:layout_below="@+id/dashboard_card_diagnosis_header"
            app:autoSizeMinTextSize="8dp"
            app:autoSizeStepGranularity="1dp"
            style="@style/Dashboard.Card.Description"/>
        <TextView
            android:id="@+id/dashboard_card_diagnosis_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_card_diagnosis_button"
            android:layout_alignParentBottom="true"
            style="@style/Dashboard.Card.Btn"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
