<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <com.texa.careapp.camera.CameraSourcePreview
        android:id="@+id/preview_automatic"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_needed_resources_automatic">
        <com.texa.careapp.camera.GraphicOverlay
            android:id="@+id/graphicOverlay_automatic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.texa.careapp.camera.CameraSourcePreview>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rl_needed_resources_automatic"
        android:background="@color/dashboard_card_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="15dp"
            android:textColor="@android:color/white"
            android:id="@+id/needed_resource_autmatic"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/relativeLayout2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_flash_automatic"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingBottom="50dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_check_border_automatic"
        android:background="@drawable/ocr_acquire_image_border_red"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/rl_external_frame_automatic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/relativeLayout2">
        <Button
            android:textColor="@android:color/white"
            android:id="@+id/bt_acquire_image_automatic"
            android:background="@color/dashboard_card_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="4dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
