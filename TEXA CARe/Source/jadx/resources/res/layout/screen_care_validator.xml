<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:tag="layout/screen_care_validator_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/margin_default"
        android:layout_marginRight="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default"
        android:fillViewport="true"
        android:layout_above="@+id/button_care_validator">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_dongle_validator_description_label"
                style="@style/OnBoarding.Title"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_dongle_validator_description"
                style="@style/OnBoarding.Description"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_forms">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_dongle_validator_pin_example_label"
                    style="@style/OnBoarding.Pin.Label"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_dongle_validator_pin_example_value"
                    style="@style/OnBoarding.Pin.Value"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_forms_big"
                android:minHeight="@dimen/edit_text_min_height">
                <EditText
                    android:id="@+id/screen_care_validator_first"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginRight="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_small"
                    style="@style/OnBoarding.Pin.Input"/>
                <EditText
                    android:id="@+id/screen_care_validator_second"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/margin_small"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_small"
                    style="@style/OnBoarding.Pin.Input"/>
            </LinearLayout>
            <TextView
                android:id="@+id/textView_care_authentication_error"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_default"
                android:text="@string/care_authentication_error"
                style="@style/OnBoarding.Error"/>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/button_care_validator"
        android:background="#e9e9e9"
        android:padding="@dimen/activity_vertical_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/button_care_validator_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0800c8"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:id="@+id/button_care_validator_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next_and_confirm"
            android:layout_centerVertical="true"
            style="@style/OnBoarding.Button"/>
    </RelativeLayout>
</RelativeLayout>
