<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:tag="layout/screen_reset_expire_schedule_0"
    android:background="@color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_default"
                android:text="@string/reset_schedule"
                android:fontFamily="@font/font_regular"
                style="@style/OotbTitleStyle"/>
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/text_new_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_default"
                android:fontFamily="@font/font_regular"
                style="@style/OotbTitleStyle"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_default">
            <LinearLayout
                android:id="@+id/layout_expired_data"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_marginBottom="0dp"
                android:layout_marginStart="@dimen/margin_small"
                android:layout_marginEnd="@dimen/margin_small">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/reset_schedule_icon"
                        android:layout_height="@dimen/reset_schedule_icon"
                        android:src="@drawable/ic_reset_schedule"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"/>
                    <View
                        android:background="@drawable/dashed_line"
                        android:layout_width="2dp"
                        android:layout_height="50dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_default">
                    <TextView
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/previous_schedule"
                        android:fontFamily="@font/font_regular"
                        android:layout_marginStart="@dimen/reset_schedule_icon_margin_left"/>
                    <TextView
                        android:textSize="@dimen/text_size_small_alert"
                        android:textColor="@color/error"
                        android:id="@+id/old_exp_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/font_light"
                        android:layout_marginStart="@dimen/margin_smaller"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_small"
                android:layout_marginTop="0dp"
                android:layout_marginRight="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_small">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/reset_schedule_icon"
                        android:layout_height="@dimen/reset_schedule_icon"
                        android:src="@drawable/ic_calendar"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:layout_marginStart="@dimen/reset_schedule_icon_margin_left"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_default">
                    <TextView
                        android:textSize="@dimen/text_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next_schedule"
                        android:fontFamily="@font/font_regular"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_new_exp_date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.texa.careapp.views.EditableDateView
                            android:layout_gravity="start"
                            android:id="@+id/edit_date_view_new_exp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/SettingsEditableDateViewValue"/>
                        <View
                            android:background="@color/out_of_the_box_light_gray"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/div_height"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/layout_new_exp_odo"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/floatabel_label_new_exp_odo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <EditText
                                android:textSize="16dp"
                                android:id="@+id/edit_text_view_new_exp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:fontFamily="@font/font_regular"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/new_exp_confirm_button"
        android:background="@drawable/button_green"
        android:padding="@dimen/margin_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_default"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="@dimen/text_size_medium"
            android:textColor="@color/primary_text_light"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/reset_schedule_button"
            android:maxLines="1"
            android:fontFamily="@font/font_regular"/>
    </LinearLayout>
</RelativeLayout>
