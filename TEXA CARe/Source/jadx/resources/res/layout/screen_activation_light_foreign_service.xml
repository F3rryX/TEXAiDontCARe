<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/tos_fragment_container"
    android:background="@color/background_light"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/screen_activation_light_foreign_service_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default"
        android:layout_marginTop="@dimen/margin_default"
        android:layout_marginRight="@dimen/margin_default"
        android:text="@string/sos_light_foreign_title"
        style="@style/Sos.Activation.Title"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_default"
        android:fillViewport="true"
        android:layout_above="@+id/screen_activation_light_foreign_service_purchase"
        android:layout_below="@+id/screen_activation_light_foreign_service_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/screen_activation_light_foreign_service_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sos_light_foreign_description"
                style="@style/Sos.Activation.Description"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_default"
                    android:src="@drawable/medical_icon"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/app_name"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:gravity="center"
        android:id="@+id/screen_activation_light_foreign_service_purchase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default"
        android:layout_marginRight="@dimen/margin_default"
        android:text="@string/sos_light_foreign_purchase"
        android:layout_above="@+id/screen_activation_light_foreign_service_purchase_info"
        style="@style/Sos.Activation.Light.Button.Light"/>
    <TextView
        android:id="@+id/screen_activation_light_foreign_service_purchase_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_default"
        android:layout_marginTop="5dp"
        android:layout_marginRight="@dimen/margin_default"
        android:layout_marginBottom="@dimen/margin_default"
        android:text="@string/sos_light_foreign_info"
        android:layout_alignParentBottom="true"
        style="@style/Sos.Activation.Light.Info"/>
</RelativeLayout>
