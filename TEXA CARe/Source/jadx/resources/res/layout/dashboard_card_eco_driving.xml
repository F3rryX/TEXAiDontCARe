<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboard_card_eco_driving"
    android:tag="layout/dashboard_card_eco_driving_0"
    android:padding="@dimen/margin_default"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#63686f"
    app:cardCornerRadius="10dp">
    <RelativeLayout
        android:background="@drawable/dashboard_card_background"
        android:padding="@dimen/margin_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/dashboard_card_eco_driving_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/dashboard_card_eco_driving_icon"
                android:layout_width="@dimen/icon_card_dimen"
                android:layout_height="@dimen/icon_card_dimen"
                android:src="@drawable/icon_card_eco_driving"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_default"
                android:layout_toRightOf="@+id/dashboard_card_eco_driving_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_default"
                android:layout_toEndOf="@+id/dashboard_card_eco_driving_icon">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_card_eco_driving_sub_title"
                    style="@style/Dashboard.Card.Module"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dashboard_card_eco_driving_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_card_eco_driving_title"
                    android:maxLines="1"
                    app:autoSizeMinTextSize="10dp"
                    app:autoSizeStepGranularity="1dp"
                    style="@style/Dashboard.Card.Title"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/dashboard_card_eco_driving_button"
            android:layout_below="@+id/dashboard_card_eco_driving_header">
            <com.texa.careapp.views.CircleDisplay
                android:id="@+id/dashboard_card_eco_driving_score"
                android:layout_width="@dimen/eco_driving_circle_display_score_dimen"
                android:layout_height="@dimen/eco_driving_circle_display_score_dimen"
                android:layout_marginTop="@dimen/eco_driving_circle_display_margin"
                android:layout_centerInParent="true"
                app:arc_width="6dp"
                app:display_text_dimension="40dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/dashboard_card_eco_driving_description"
                android:paddingTop="@dimen/margin_smaller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eco_driving_no_firmware_description"
                android:maxLines="3"
                android:layout_centerInParent="true"
                android:marqueeRepeatLimit="marquee_forever"
                app:autoSizeMinTextSize="8dp"
                app:autoSizeStepGranularity="1dp"
                style="@style/Dashboard.Card.Description"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/dashboard_card_eco_driving_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_card_eco_driving_button"
            android:layout_alignParentBottom="true"
            style="@style/Dashboard.Card.Btn"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
