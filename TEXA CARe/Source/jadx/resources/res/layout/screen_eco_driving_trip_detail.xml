<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/screen_eco_driving_trip_detail_0"
    android:background="@color/eco_driving_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/screen_eco_driving_trip_detail_locations"
        android:paddingLeft="@dimen/margin_small"
        android:paddingTop="@dimen/margin_small"
        android:paddingRight="@dimen/margin_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/EcoDriving.Trip.Detail.Title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/screen_eco_driving_trip_detail_list"
        android:paddingTop="125dp"
        android:paddingBottom="60dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_below="@+id/screen_eco_driving_trip_detail_locations"/>
    <RelativeLayout
        android:id="@+id/screen_eco_driving_trip_detail_header"
        android:background="@color/eco_driving_background_header"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_below="@+id/screen_eco_driving_trip_detail_locations">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/screen_eco_driving_trip_detail_score">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eco_driving_trip_detail_distance"
                style="@style/EcoDriving.Trip.Detail.Label"/>
            <View
                android:background="@color/eco_driving_normal_color"
                android:layout_width="90dp"
                android:layout_height="0.5dp"/>
            <TextView
                android:id="@+id/screen_eco_driving_trip_detail_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/EcoDriving.Trip.Detail.Value"/>
        </LinearLayout>
        <com.texa.careapp.views.CircleDisplay
            android:id="@+id/screen_eco_driving_trip_detail_score"
            android:layout_width="@dimen/eco_driving_circle_display_score_dimen"
            android:layout_height="@dimen/eco_driving_circle_display_score_dimen"
            android:layout_margin="5dp"
            android:layout_centerInParent="true"
            app:arc_width="6dp"
            app:display_text_dimension="50dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/screen_eco_driving_trip_detail_score">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eco_driving_trip_detail_duration"
                style="@style/EcoDriving.Trip.Detail.Label"/>
            <View
                android:background="@color/eco_driving_normal_color"
                android:layout_width="90dp"
                android:layout_height="0.5dp"/>
            <TextView
                android:id="@+id/screen_eco_driving_trip_detail_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/EcoDriving.Trip.Detail.Value"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/screen_eco_driving_trip_detail_hint"
        android:background="0x7f08005d"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/screen_eco_driving_trip_detail_hint_text"
            android:paddingTop="22dp"
            android:paddingBottom="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/margin_default"
            android:drawableEnd="0x7f0800d6"
            android:paddingStart="70dp"
            android:paddingEnd="5dp"
            style="@style/EcoDriving.Trip.Detail.Hint"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/eco_driving_trip_detail_scroll_to_bottom"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="0x7f080139"
        android:layout_above="@+id/screen_eco_driving_trip_detail_hint"
        android:layout_marginEnd="5dp"
        android:layout_alignParentEnd="true"
        android:elevation="5dp"
        android:backgroundTint="@color/eco_driving_background"
        app:borderWidth="1dp"/>
</RelativeLayout>
