<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="30dp"
                android:width="30dp"/>
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="1dp"
                android:color="@color/dashboard_card_positive"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <size
                android:height="20dp"
                android:width="20dp"/>
            <solid android:color="@color/dashboard_card_positive"/>
        </shape>
    </item>
</layer-list>
