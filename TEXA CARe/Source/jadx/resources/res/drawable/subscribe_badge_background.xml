<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="100dp"
                android:width="100dp"/>
            <solid android:color="#f5a623"/>
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <size
                android:height="20dp"
                android:width="20dp"/>
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <size
                android:height="30dp"
                android:width="30dp"/>
            <solid android:color="#f5a623"/>
        </shape>
    </item>
</layer-list>
