    <LinearLayout android:orientation="horizontal" android:id="@id/layout_add_confirmed" android:background="@drawable/button_green" android:padding="@dimen/margin_default" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/margin_default" android:layout_marginTop="@dimen/margin_default" android:layout_alignParentBottom="true">
        <TextView android:textSize="@dimen/text_size_medium" android:textColor="@color/primary_text_light" android:ellipsize="end" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/btn_confirm" android:maxLines="1" android:fontFamily="@font/font_regular" />
    </LinearLayout>
