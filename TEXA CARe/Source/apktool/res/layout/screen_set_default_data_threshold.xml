            <TextView android:gravity="center_horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_default" android:text="@string/expiration" android:fontFamily="@font/font_regular" style="@style/OotbTitleStyle" />
            <TextView android:gravity="center_horizontal" android:id="@id/threshold_titol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_default" android:text="@string/new_schedule" android:fontFamily="@font/font_regular" style="@style/OotbTitleStyle" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/margin_default">
            <TextView android:textSize="@dimen/text_add_schedules_label" android:id="@id/vehicle_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_new_threshold" android:fontFamily="@font/font_light" />
            <LinearLayout android:orientation="horizontal" android:id="@id/layout_new_exp_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/margin_small" android:minHeight="@dimen/edit_text_min_height">
                <com.texa.careapp.views.EditableDateView android:id="@id/editDateView_new_threshold" style="@style/SettingsEditableDateViewValue" />
