<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:tag="layout/screen_personal_data_0" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ScrollView android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_above="@id/screen_signup_personal_data_complete_registration">
        <LinearLayout android:orientation="vertical" android:paddingLeft="@dimen/margin_default" android:paddingRight="@dimen/margin_default" android:paddingBottom="@dimen/margin_default" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/signup_personal_data_title_label" style="@style/Auth.Title" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/signup_personal_data_description" style="@style/Auth.Description" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_default" android:text="@string/signup_personal_data_name_label" style="@style/Auth.Label" />
            <com.google.android.material.textfield.TextInputLayout android:id="@id/screen_signup_personal_data_name_input" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@id/screen_signup_personal_data_name_edit_text" android:layout_width="match_parent" android:layout_height="match_parent" android:inputType="textCapWords" style="@style/Auth.Edit" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@id/screen_signup_personal_data_surname_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_default" android:text="@string/signup_personal_data_surname_label" style="@style/Auth.Label" />
            <com.google.android.material.textfield.TextInputLayout android:id="@id/screen_signup_personal_data_surname_input" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@id/screen_signup_personal_data_surname_edit_text" android:layout_width="match_parent" android:layout_height="match_parent" android:inputType="textCapWords" style="@style/Auth.Edit" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_default" android:text="@string/signup_personal_data_phone_number_label" style="@style/Auth.Label" />
            <com.google.android.material.textfield.TextInputLayout android:id="@id/screen_signup_personal_data_phone_number_input" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@id/screen_signup_personal_data_phone_number_edit_text" android:layout_width="match_parent" android:layout_height="match_parent" android:inputType="phone" style="@style/Auth.Edit" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_default" android:text="@string/screen_signup_personal_data_birth_date_label" style="@style/Auth.Label" />
            <com.google.android.material.textfield.TextInputLayout android:id="@id/screen_signup_personal_data_birthday_input" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@id/screen_signup_personal_data_birthday_edit_text" android:layout_width="match_parent" android:layout_height="match_parent" android:drawableRight="@drawable/ic_calendar" android:drawablePadding="@dimen/activity_horizontal_margin" android:drawableEnd="@drawable/ic_calendar" style="@style/Auth.Edit" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout android:id="@id/screen_signup_personal_data_complete_registration" android:background="#e9e9e9" android:padding="@dimen/activity_vertical_margin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true">
        <TextView android:id="@id/screen_signup_personal_data_complete_registration_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signup_personal_data_complete_registration" style="@style/Auth.Button" />
    </RelativeLayout>
</RelativeLayout>
