                    <TextView android:textSize="@dimen/text_size_small" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connection_data" android:lines="2" android:fontFamily="@font/font_light" />
                </LinearLayout>
